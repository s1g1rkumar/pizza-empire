# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MySQL 8 Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pizza_empire_tycoon
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_ACCESS_SECRET=change_me_to_a_long_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
