# Production Backend Environment Template (DO NOT COMMIT REAL .env FILES)
NODE_ENV=production
PORT=4000

# MySQL 8 Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pizza_empire_prod
DB_USER=pizza_empire_app
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD
DB_POOL_LIMIT=20

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & CORS
CORS_ORIGIN=https://pizzaempire.example.com
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
